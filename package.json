{
  "name": "ai-distributed-workflow-engine",
  "version": "0.1.0",
  "description": "AI-powered distributed workflow orchestration engine (DAG workflows on Node.js, MongoDB, Redis, Kafka)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/worker.js",
    "dev:worker": "nodemon src/worker.js",
    "consumer:analytics": "node src/consumers/analytics.js",
    "create-admin": "node scripts/create-admin.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit integration --runInBand",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "test:llm": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects llm --runInBand",
    "check:secrets": "node scripts/check-secrets.js",
    "audit": "npm audit --omit=dev",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit integration --runInBand --coverage --coverageReporters=text-summary --coverageReporters=json-summary --collectCoverageFrom=\"src/**/*.js\" --collectCoverageFrom=\"!src/server.js\" --collectCoverageFrom=\"!src/worker.js\" --collectCoverageFrom=\"!src/consumers/**\"",
    "chaos": "node scripts/chaos.js",
    "app:up": "docker compose -f docker/docker-compose.yml --env-file .env --profile app up -d --build --wait",
    "app:down": "docker compose -f docker/docker-compose.yml --env-file .env --profile app rm -sf api worker analytics-consumer"
  },
  "keywords": [
    "workflow",
    "dag",
    "distributed-systems",
    "redis",
    "mongodb",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@langchain/textsplitters": "^1.0.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cron-parser": "^5.10.1",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.10.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0"
  }
}
