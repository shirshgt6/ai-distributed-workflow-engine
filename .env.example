# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Real secrets (JWT keys, API keys) are added in later phases
# and must only ever live in .env / your secret manager, never in this file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Host ports 27018 / 6380 (not the defaults) so this project can run alongside
# Project 1's containers without port clashes. See docker/docker-compose.yml.
# directConnection=true: talk straight to the single replica-set member.
MONGO_URI=mongodb://localhost:27018/workflow_engine?directConnection=true
REDIS_URL=redis://localhost:6380

# How long graceful shutdown may take before the process force-exits.
SHUTDOWN_TIMEOUT_MS=10000

# Maximum accepted JSON request body.
BODY_LIMIT=100kb

# --- Auth (Phase 2) ---
# REPLACE BOTH with long random values, and keep them DIFFERENT:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# These placeholders only exist so the app boots in a fresh clone; never use them outside local dev.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt work factor (each +1 doubles hashing time).
BCRYPT_COST=12

# --- Execution: Redis queue + worker (Phase 6) ---
# Max task handlers running at once in this process.
WORKER_CONCURRENCY=4
# Idle worker poll interval.
QUEUE_POLL_INTERVAL_MS=200
# Redis lease right after popping a task (before it is claimed in MongoDB).
QUEUE_CLAIM_LEASE_MS=30000
# Running-task lease, renewed by the worker every LEASE_TTL_MS/3 while the handler runs.
# If the worker dies, another worker may take the task over after at most this long.
LEASE_TTL_MS=15000
# Reconciler: every RECONCILE_INTERVAL_MS, re-dispatch READY/QUEUED tasks older than
# RECONCILE_STALE_MS and RUNNING tasks whose lease expired (MongoDB is the truth).
RECONCILE_INTERVAL_MS=5000
RECONCILE_STALE_MS=10000

# --- Kafka lifecycle events (Phase 11) ---
# Host port 9095 (docker/docker-compose.yml). Events are written to the MongoDB outbox
# in the same transaction as each state change; workers relay them to this topic.
KAFKA_BROKERS=localhost:9095
KAFKA_TOPIC=workflow-events
OUTBOX_RELAY_INTERVAL_MS=500

# --- Scheduler (Phase 12) ---
# Runs inside worker processes; one leader (Redis lock) starts due cron runs.
SCHEDULER_TICK_MS=5000

# --- LLM (Phase 13+) ---
# Any OpenAI-compatible API. Default: local Ollama (ollama pull qwen2.5:0.5b && ollama pull nomic-embed-text).
# LLM_PROVIDER=mock runs without any model (deterministic fake, for demos/tests).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=   # only for hosted providers; put the real key in .env, never here
LLM_MODEL_SMALL=qwen2.5:0.5b
LLM_MODEL_LARGE=qwen2.5:0.5b
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT_MS=60000
